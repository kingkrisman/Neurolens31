# Copy to .env.local and fill in. .env.local is gitignored.
#
# Run `npm run check:env` after editing: it confirms the project is actually
# reachable and the key is accepted, which is the one thing a well-formed but
# wrong value will not tell you.

# https://<project-ref>.supabase.co  — from the project's API settings.
# Check the spelling. "superbase.co" is a valid URL pointing at nothing, and it
# broke sign-in in production for days.
VITE_SUPABASE_URL=

# The project's anon (publishable) key. This one belongs in the browser: it is
# public by design, and row-level security in the database is what decides who
# can read what. Never put the service_role key here — it bypasses every policy.
VITE_SUPABASE_ANON_KEY=

# Optional. The canonical origin, used for canonical URLs, sitemap.xml and
# structured data. Defaults to https://neurolens.space.
VITE_SITE_URL=

# Optional. An external analytics collector, if you would rather not use the
# app's own /api/analytics endpoint. Must be https.
# VITE_ANALYTICS_ENDPOINT=
